{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rambutan Slicer",
  "version": "0.7.7",
  "identifier": "com.rambutanslicer.desktop",
  "build": {
    "beforeDevCommand": "npm run build:thumbnail-providers && npm run dev",
    "beforeBuildCommand": "npm run build:tauri && npm run build:thumbnail-providers",
    "devUrl": "http://localhost:3005",
    "frontendDist": "frontend-dist"
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": [
          "voxl"
        ],
        "name": "Rambutan Slicer Scene File",
        "description": "Rambutan Slicer Scene",
        "mimeType": "application/vnd.dragonfruit.voxl+json"
      },
      {
        "ext": [
          "lumen"
        ],
        "name": "ORA LUMEN File",
        "description": "LUMEN Print File",
        "mimeType": "application/vnd.openresin.lumen"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "macos-fps": {
      "enabled": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "/splashscreen.html",
        "width": 600,
        "height": 400,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "alwaysOnTop": true,
        "theme": "Dark",
        "backgroundColor": "#0a0607",
        "title": "Rambutan Slicer"
      },
      {
        "label": "main",
        "create": false,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#071613",
        "title": "Rambutan Slicer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "maximized": false,
        "resizable": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 10000,
          "y": 10000
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https: http:; font-src 'self' data:; media-src 'self' data: blob: http: https:; worker-src 'self' blob:; connect-src 'self' blob: ipc: http://ipc.localhost asset: http://asset.localhost http: https: ws: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "capabilities": [
        "default",
        "logging"
      ]
    }
  }
}
